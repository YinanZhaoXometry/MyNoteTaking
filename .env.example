# Copy to .env for local overrides (never commit .env)
FLASK_ENV=development
SECRET_KEY=change-me-in-production

# OpenRouter (translation)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Neon Postgres (required on Vercel; omit DATABASE_URL locally to use SQLite)
# Prefer the pooler URL on Vercel/serverless (set as DATABASE_URL in the dashboard).
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_POOLED=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Optional: Vercel CLI deploy without interactive login (create at vercel.com/account/tokens)
# VERCEL_TOKEN=
